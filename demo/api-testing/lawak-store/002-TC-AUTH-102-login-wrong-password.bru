meta {
  name: TC-AUTH-102 S01 Wrong password returns 401
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "{{adminEmail}}", "password": "qa-auto-wrong-password" }
}

assert {
  res.status: eq 401
}

tests {
  test("TC-AUTH-102 S01: error code is INVALID_CREDENTIALS", function () {
    expect(res.getBody().error.code).to.equal("INVALID_CREDENTIALS");
    expect(res.getBody().token).to.equal(undefined);
  });
}

docs {
  Case: TC-AUTH-102 step 1
}
